# sway config — near-stock defaults + customizations (tagged [mine]).
# Dynamic values (font, cursor, wallpaper, colors, popup anchors) come from
# machine/theme.nix via extraConfig.
#
# Focus uses VIM DIRECTIONS: h=left j=down k=up l=right.
# Consequence: $mod+h does NOT split (that's the whole point).
# Horizontal split moved to $mod+semicolon; vertical stays $mod+v.

set $mod Mod4
set $alt Mod1
set $term ghostty
set $menu fuzzel

# Dynamic values (font, cursor, wallpaper, colors, popup anchors) are set in
# extraConfig from machine/theme.nix. This file is the static base.

# [mine] i3 behavior
focus_follows_mouse yes
# [mine] never auto-hide the cursor (hiding after 3s idle was killing it while typing)
seat * hide_cursor 0

# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------
# Wallpaper + mode are set in extraConfig from machine/theme.nix.
# [mine] lock scale: sway auto-detects 2.0 for HiDPI panels, violating scale 1.
output * scale 1

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
input type:touchpad {
    # palm-rejection jank
    dwt disabled
    # drag-the-content scrolling
    natural_scroll enabled
    tap enabled
    # 2 fingers = right-click, 3 fingers = middle-click (libinput
    # lrm = 1:L 2:R 3:M; lmr would make 2 fingers = middle, 3 = right)
    tap_button_map lrm
    # click_method none: kill the clickpad corner zones (button_areas
    # = default maps bottom/right corner single-clicks to right/middle). This
    # way a ONE-finger PRESS is always left everywhere; right/middle comes from
    # 2/3-finger taps above instead. (libinput has no "2-finger double-click"
    # mapping - taps are single L/R/M button presses only.)
    click_method none
    # 4K speed (~2x default 0.0). sway 1.12 renamed accel_speed -> pointer_accel
    pointer_accel 0.6
}

# 4K speed for mice / external pointers. FLAT profile = no acceleration
# curve, pure constant speed (~2x default 0.0, range -1..1). One setting per line!
# sway 1.12 renamed accel_speed -> pointer_accel
input type:pointer accel_profile flat
input type:pointer pointer_accel 0.6

# ---------------------------------------------------------------------------
# Appearance — Regolith-style pixel borders (colors set in extraConfig)
# ---------------------------------------------------------------------------
default_border pixel 2
default_floating_border pixel 2
# [mine] hold $mod to grab/drag a floating window from anywhere on it
floating_modifier $mod

# ---------------------------------------------------------------------------
# Autostart
# ---------------------------------------------------------------------------
exec kanshi                             # monitor hotplug profiles
exec mako                               # notifications
exec swayosd-server                     # volume/brightness OSD popups
exec nm-applet --indicator              # wifi tray menu (NetworkManager)
# Bluetooth status lives in the waybar bluetooth module (no tray applet since
# the bluejay switch). $mod+b / waybar click toggles the manager (bluejay).
exec polkit-gnome-authentication-agent-1 # root auth prompts (replaces default)

# Locks ONLY when the machine actually sleeps (e.g. lid close). No idle timers.
exec swayidle -w before-sleep 'swaylock -f -c 282828'

# Game launcher menu (quickshell) — starts hidden, $mod+g toggles it. NOT
# exec_always: set-res.sh's `swaymsg reload` must not respawn it (`exec` only
# runs at startup; -n blocks a duplicate if ever started by hand too).
exec qs -n

# ---------------------------------------------------------------------------
# Screenshots — clipboard only, Windows-snipping-tool style
#   PrintScreen        whole screen -> clipboard
#   Ctrl+PrintScreen   focused window -> clipboard
#   $mod+Shift+s       snip tool: rectangle select with LIVE PIXEL MEASUREMENTS
# ---------------------------------------------------------------------------
bindsym Print               exec ~/.config/sway/scripts/screenshot.sh full
bindsym Ctrl+Print          exec ~/.config/sway/scripts/screenshot.sh window
bindsym $mod+Shift+s        exec ~/.config/sway/scripts/screenshot.sh snip

# Resolution presets (game streaming / native play on the Intel GPU)
bindsym $mod+F10 exec ~/.config/sway/scripts/set-res.sh 720     # native play
bindsym $mod+F11 exec ~/.config/sway/scripts/set-res.sh 1080    # streaming
bindsym $mod+F12 exec ~/.config/sway/scripts/set-res.sh 4k      # desktop

# Brightness/volume OSD via swayosd (server autostarted above)
# --min-brightness overrides swayosd's default 5% floor; 1% = raw 1200/120000.
bindsym XF86MonBrightnessDown exec swayosd-client --brightness lower --min-brightness 1
bindsym XF86MonBrightnessUp exec swayosd-client --brightness raise
bindsym XF86AudioLowerVolume exec swayosd-client --output-volume lower
bindsym XF86AudioRaiseVolume exec swayosd-client --output-volume raise
bindsym XF86AudioMute exec swayosd-client --output-volume mute-toggle

# Media keys (playerctl)
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# Nightlight toggle (wlsunset orange 4000K, hotkey-only, no timer). $mod+o = Orange.
bindsym $mod+o exec ~/.config/sway/scripts/wlsunset-toggle.sh

# ---------------------------------------------------------------------------
# Core bindings — STOCK SWAY DEFAULTS from here down (except tags)
# ---------------------------------------------------------------------------
bindsym $mod+Return exec $term
bindsym $mod+Shift+Return exec zen --new-window                  # default browser, new window (opens Zen new-tab page, visible with icon)
bindsym $mod+d exec $menu
bindsym $mod+g exec qs ipc call menu toggle   # [mine] game launcher menu (quickshell)
bindsym $mod+Shift+q kill

# focus: vim directions + arrows [mine - vim-style]
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# splits: ; took over horizontal when h became focus-left; v is stock
bindsym $mod+semicolon splith
bindsym $mod+v splitv
bindsym $mod+f fullscreen toggle
bindsym $mod+a focus parent
bindsym $mod+b exec ~/.config/sway/scripts/bluejay-toggle.sh  # toggle bluetooth manager (bluejay; floats via rules below)
bindsym $mod+BackSpace exec sudo -n /run/current-system/sw/bin/unwedge  # 9260 wedge: re-arm BT page scan (controller won't reconnect)
bindsym $mod+Shift+w exec sudo -n /run/current-system/sw/bin/problue-wire-switch  # ProBlue: toggle wired USB input (ON before plugging in = cable as gamepad); applies to next plug

bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+0 workspace number 10

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9
bindsym $mod+Shift+0 move container to workspace number 10

bindsym $mod+minus move scratchpad
bindsym $mod+Shift+minus scratchpad show

bindsym $mod+Shift+c reload

# Keybind help dialog (searchable list of shortcuts, fuzzel --dmenu)
bindsym $mod+F1 exec ~/.config/sway/scripts/keys.sh

# Notification history (fuzzel --dmenu viewer of mako's history buffer)
bindsym $mod+n exec ~/.config/sway/scripts/notif-history.sh

# Global EN/Pinyin toggle is handled in machine/fcitx5.nix (extraConfig).
# $mod+Shift+t = Text.

set $resize_mode Resize
mode $resize_mode {
    # same vim directions as focus: pull edges around
    bindsym h resize shrink width 30 px
    bindsym j resize shrink height 30 px
    bindsym k resize grow height 30 px
    bindsym l resize grow width 30 px
    bindsym Left resize shrink width 30 px
    bindsym Down resize shrink height 30 px
    bindsym Up resize grow height 30 px
    bindsym Right resize grow width 30 px
    bindsym Escape mode default
    bindsym Return mode default
}
bindsym $mod+r mode $resize_mode

bindsym $mod+Shift+e exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'

# ---------------------------------------------------------------------------
# Window rules — floating popups, IME app routing, Dolphin dialogs
# ---------------------------------------------------------------------------
for_window [app_id="(?i)signal"] move to workspace number 9
for_window [class="(?i)signal"] move to workspace number 9
for_window [app_id="(?i)discord"] move to workspace number 9
for_window [class="(?i)discord"] move to workspace number 9
for_window [app_id="(?i)slack"] move to workspace number 8
for_window [class="(?i)slack"] move to workspace number 8
for_window [title="Spacers"] floating enable
for_window [app_id="(?i)qalculate"] floating enable
for_window [title="Qalculate!"] floating enable
# pavucontrol/bluejay: float them (don't tile). Anchors and sizes are set
# in extraConfig from machine/theme.nix (popups). pavucontrol has X11-class
# rules (XWayland); bluejay is native Wayland → app_id only.
for_window [app_id="(?i)pavucontrol"] floating enable
for_window [class="(?i)pavucontrol"] floating enable
for_window [app_id="(?i)io.github.ebonjaeger.bluejay"] floating enable
# EasyEffects (GTK3 audio effects, native Wayland): float it — it's a settings
# panel, not a tiling app. Default size/position is fine.
for_window [app_id="(?i)org.kde.easyeffects"] floating enable
# Dolphin (KDE, native Wayland): its confirm/progress dialogs (Delete, Copying,
# Moving, Extracting...) are xdg_toplevel windows just like the main window -
# Wayland exposes no window role/type (window_role/window_type are XWayland-only
# criteria), so match by title keywords, scoped to the Dolphin app_id.
# CAVEAT: sway evaluates for_window rules ONCE, at the moment the window maps,
# and NEVER re-runs them on later title changes (view_execute_criteria is only
# called from view_map). Titles measured on this machine at map time:
#   progress window:  "Copying — Dolphin"  (later churns to "Copying (66% ...)")
#   overwrite dialog: "File Already Exists — Dolphin"
#   main windows:     "<path> — Dolphin", "trash:/ — Dolphin", "smb://... — Dolphin"
for_window [app_id="(?i)org\.kde\.dolphin" title="(?i)(delete|trash|copy(ing)?|mov(e|ing)|renam|progress|extract|overwrit|skip|conflict|error|exist|propert(ies|y)|open with|about)"] floating enable
# Main-window rescue: the float rule above also matches keywords inside main
# window titles (e.g. trash:/ or a folder named Copy), and sway applies rules
# in config order, so this runs after and re-tiles them. Scoped to LOCATION
# titles only: paths start with "/", special places are scheme URIs containing
# ":/" (trash:/, smb://, network:/). Dialog captions ("Copying", "File Already
# Exists", "Delete File?...") never contain either, so this cannot un-float
# them anymore - the old catch-all suffix rule was exactly why Dolphin's
# progress/confirm dialogs kept coming up tiled.
for_window [app_id="(?i)org\.kde\.dolphin" title="(?i)(^/|:/).* ([—–-]) dolphin$"] floating disable

# ---------------------------------------------------------------------------
# Bar
# ---------------------------------------------------------------------------
bar {
    position bottom
    swaybar_command waybar
}
