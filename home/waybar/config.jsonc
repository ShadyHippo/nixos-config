// waybar — gruvbox, replaces i3xrocks
{
    "layer": "top",
    "position": "bottom",
    "height": 44,
    "margin-top": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": [
        "pulseaudio",
        "memory",
        "custom/disk",
        "temperature",
        "battery",
        "tray",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/window": {
        "max-length": 50
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "clock": {
        // day month time - no year
        "format": " {:%d %b %H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    // Volume: native pulseaudio module (speaks pipewire-pulse, so still
    // PipeWire underneath). Icon set (all in Cousine Nerd Font 3.5.0, all BMP):
    //   muted \uEEE8, then levels up: \uF026 \uF027 \uEFCF \uF028.
    // format-icons = indexed by volume (low -> high); format-muted = muted icon.
    // \uEFCF only exists in Nerd Fonts 3.5.0 (we pin nixos-unstable); 3.4.0's
    // MDI block stopped at \uEFCE, which is why it was a box before.
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uEEE8 {volume}%",
        "format-icons": ["\uF026", "\uF027", "\uEFCF", "\uF028"],
        "on-click": "~/.config/sway/scripts/pavucontrol-toggle.sh",
        "on-scroll-up": "swayosd-client --output-volume raise",
        "on-scroll-down": "swayosd-client --output-volume lower"
    },

    // RAM: computer-chip icon; amber >50, red >80.
    "memory": {
        "format": " \uF2DB {}%",
        "states": {"warning": 50, "critical": 80},
        "tooltip-format": "RAM: {percentage}% used"
    },

    // CPU temp: point straight at the coretemp package sensor. Waybar 0.15
    // ignores `hwmon-by-name` (falls back to thermal_zone0 = pch_cannonlake),
    // which is why it read ~42C. coretemp temp1_input == x86_pkg_temp.
    // amber >60, red >80.
    "temperature": {
        "hwmon-path": "/sys/devices/platform/coretemp.0/hwmon/hwmon6/temp1_input",
        "format": " \uF2C9 {temperatureC}°C",
        "warning-threshold": 60,
        "critical-threshold": 80,
        "format-critical": " \uF2C9 {temperatureC}°C",
        "tooltip-format": "CPU temp: {temperatureC}°C"
    },

    // Disk: custom module so it matches Dolphin's user-available %. Waybar's
    // built-in disk module counts from root-reserved blocks (reads ~13% here
    // vs Dolphin's ~19%). The script computes (total - avail)/total. It also
    // emits warning/critical classes for amber/red (>=70 / >=80).
    "custom/disk": {
        "exec": "~/.config/sway/scripts/waybar-disk.sh",
        // JSON output: without return-type=json Waybar uses parseOutputRaw()
        // and prints the raw JSON string. This enables parseOutputJson().
        "return-type": "json",
        "interval": 30,
        "format": "{text}"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": " \uF0E7 {capacity}%",
        "format-icons": ["\uF244", "\uF243", "\uF242", "\uF241", "\uF240"],
        "interval": 30
    },

    "tray": {
        "icon-size": 28,
        "spacing": 10
    }
}
