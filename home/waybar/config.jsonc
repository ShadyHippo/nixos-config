// waybar — gruvbox, replaces i3xrocks
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 0,

    "modules-left": ["sway/workspaces", "sway/mode"],
    "modules-center": ["sway/window"],
    "modules-right": [
        "pulseaudio",
        "bluetooth",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "tray",
        "clock"
    ],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/window": {
        "max-length": 50
    },

    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },

    "clock": {
        // day month time - no year
        "format": "{:%d %b %H:%M}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": " {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": " {}%",
        "tooltip": false
    },

    "temperature": {
        "thermal-zone": 0,
        "hwmon-path-abs": ["/sys/devices/virtual/thermal/thermal_zone*"],
        "input-filename": "temp",
        "adaptive-file-selection": true,
        "format": "{temperatureC}°C",
        "critical-threshold": 90,
        "format-critical": " {temperatureC}°C"
    },

    "battery": {
        "states": {
            "warning": 25,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "interval": 30
    },

    "bluetooth": {
        "format": " {status}",
        "format-disabled": "",
        "format-connected": " {num_connections}",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{device_alias}\t{device_address}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": " muted",
        "format-icons": {"default": ["", ""]},
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    }
}
