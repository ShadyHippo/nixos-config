diff --git a/native/gamepadSwap.js b/native/gamepadSwap.js
new file mode 100644
index 0000000..d322e59
--- /dev/null
+++ b/native/gamepadSwap.js
@@ -0,0 +1,93 @@
+// Swap A/B and X/Y face buttons (jellyfin-desktop#958). Nintendo-style
+// controllers label the four face-button positions opposite to Xbox; when the
+// "swap_abxy" client setting is on:
+//  1. navigator.getGamepads() returns pads with buttons 0/1 and 2/3 swapped,
+//     so jellyfin-web's gamepad handler sees Nintendo-correct positions.
+//  2. A checkbox is grafted onto the web client's Controls settings page,
+//     directly under "Enable Gamepad" — the only place a user would look.
+(function() {
+    const SWAP_SECTION = 'gamepad settings';
+    const SWAP_KEY = 'swap_abxy';
+    const ROW_ID = 'jfdSwapAbxyRow';
+
+    const swapSetting = () => {
+        const info = window.jmpInfo;
+        return info && info.settings && info.settings[SWAP_SECTION];
+    };
+
+    // ---- Gamepad API boundary ------------------------------------------------
+    const nativeGetGamepads = navigator.getGamepads ? navigator.getGamepads.bind(navigator) : null;
+    if (nativeGetGamepads) {
+        navigator.getGamepads = function() {
+            const pads = nativeGetGamepads();
+            if (!pads) return pads;
+
+            const settings = swapSetting();
+            if (!settings || !settings[SWAP_KEY]) return pads;
+
+            const out = [];
+            for (let i = 0; i < pads.length; i++) {
+                const pad = pads[i];
+                if (!pad) {
+                    out.push(pad);
+                    continue;
+                }
+                const buttons = pad.buttons.slice();
+                [buttons[0], buttons[1]] = [buttons[1], buttons[0]];
+                [buttons[2], buttons[3]] = [buttons[3], buttons[2]];
+                out.push(new Proxy(pad, {
+                    get(target, prop) {
+                        if (prop === 'buttons') return buttons;
+                        const value = target[prop];
+                        return typeof value === 'function' ? value.bind(target) : value;
+                    }
+                }));
+            }
+            return out;
+        };
+    }
+
+    // ---- Controls-page graft -------------------------------------------------
+    // The Controls page is served by jellyfin-web (the server's copy), so the
+    // client cannot add a field upstream — inject one instead, cloning the
+    // page's own checkboxContainer markup so it renders natively.
+    const injectSwapRow = () => {
+        const page = document.getElementById('controlsPreferencesPage');
+        if (!page) return;
+        const anchor = page.querySelector('.enableGamepadContainer');
+        if (!anchor) return;
+        if (document.getElementById(ROW_ID)) return;
+
+        const row = document.createElement('div');
+        row.className = 'checkboxContainer';
+        row.id = ROW_ID;
+
+        // Clone the page's own label instead of createElement({is}):
+        // webcomponents.js patches document.createElement and throws on the
+        // options argument. The clone keeps the upgraded emby-checkbox
+        // structure, so it renders identically to Enable Gamepad.
+        const label = anchor.querySelector('label').cloneNode(true);
+        const input = label.querySelector('input');
+        input.className = 'chkSwapAbxy';
+        input.name = '';
+        const settings = swapSetting();
+        input.checked = !!(settings && settings[SWAP_KEY]);
+        input.addEventListener('change', () => {
+            const current = swapSetting();
+            if (current) current[SWAP_KEY] = input.checked;
+        });
+        label.querySelector('span').textContent = 'Swap A/B and X/Y gamepad buttons';
+
+        row.appendChild(label);
+        anchor.insertAdjacentElement('afterend', row);
+    };
+
+    // Runs at DocumentCreation — document.documentElement does NOT exist yet,
+    // but the document node always does; the row injects once the controls
+    // page is parsed into it.
+    new MutationObserver(injectSwapRow).observe(document, {
+        childList: true,
+        subtree: true
+    });
+    injectSwapRow();
+})();
