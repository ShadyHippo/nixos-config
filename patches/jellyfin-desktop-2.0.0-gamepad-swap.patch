+///////////////////////////////////////////////////////////////////////////////////////////////////
+// Nintendo-style controllers label the face buttons the opposite way around
+// from Xbox (A/B and X/Y on swapped positions — jellyfin-desktop#958). With
+// the "Swap A/B and X/Y gamepad buttons" client setting on, swap the raw SDL
+// button indices before they hit the inputmaps.
+static QString swappedFaceButton(const QString &keycode)
+{
+  if (!keycode.startsWith("KEY_BUTTON_"))
+    return keycode;
+
+  if (!SettingsComponent::Get().value(SETTINGS_SECTION_GAMEPAD, "swap_abxy").toBool())
+    return keycode;
+
+  bool ok = false;
+  int button = keycode.mid(11).toInt(&ok);
+  if (!ok)
+    return keycode;
+  if (button == 0 || button == 1)
+    return QString("KEY_BUTTON_%1").arg(1 - button);
+  if (button == 2 || button == 3)
+    return QString("KEY_BUTTON_%1").arg(5 - button);
+  return keycode;
+}
+
 ///////////////////////////////////////////////////////////////////////////////////////////////////
 void InputComponent::remapInput(const QString &source, const QString &keycode, InputBase::InputkeyState keyState)
 {
